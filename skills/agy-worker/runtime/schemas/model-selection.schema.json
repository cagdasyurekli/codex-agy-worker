{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "agy-worker driver selection record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "selection_mode"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "kind": {"type": "string", "const": "agy-worker-selection"},
    "selection_mode": {"type": "string", "enum": ["tier", "exact-model", "model-effort"]},
    "selected_tier": {"type": "string", "minLength": 1},
    "selected_tier_source": {"type": "string", "enum": ["cli", "environment", "implicit-default"]},
    "user_model": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$", "maxLength": 128},
    "user_model_source": {"type": "string", "enum": ["cli", "environment"]},
    "user_effort": {"type": "string", "enum": ["low", "medium", "high"]},
    "user_effort_source": {"type": "string", "enum": ["cli", "environment"]},
    "resolved_agy_model": {
      "oneOf": [
        {"type": "string", "minLength": 1, "maxLength": 128},
        {"type": "null"}
      ]
    },
    "installed_agy_version": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"},
    "matrix_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "matrix_agy_version": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"},
    "matrix_source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
  },
  "oneOf": [
    {
      "title": "legacy tier selection",
      "required": [
        "schema_version",
        "kind",
        "selection_mode",
        "selected_tier",
        "selected_tier_source",
        "resolved_agy_model"
      ],
      "properties": {
        "selection_mode": {"const": "tier"}
      },
      "allOf": [
        {
          "if": {
            "required": ["selected_tier"],
            "properties": {"selected_tier": {"const": "default"}}
          },
          "then": {"properties": {"resolved_agy_model": {"type": "null"}}},
          "else": {"properties": {"resolved_agy_model": {"type": "string", "minLength": 1}}}
        },
        {
          "if": {
            "required": ["selected_tier_source"],
            "properties": {"selected_tier_source": {"const": "implicit-default"}}
          },
          "then": {"properties": {"selected_tier": {"const": "bulk"}}}
        }
      ],
      "not": {
        "anyOf": [
          {"required": ["user_model"]},
          {"required": ["user_model_source"]},
          {"required": ["user_effort"]},
          {"required": ["user_effort_source"]},
          {"required": ["installed_agy_version"]},
          {"required": ["matrix_sha256"]},
          {"required": ["matrix_agy_version"]},
          {"required": ["matrix_source_revision"]}
        ]
      }
    },
    {
      "title": "exact reviewed model selection",
      "required": [
        "schema_version",
        "kind",
        "selection_mode",
        "user_model",
        "user_model_source",
        "resolved_agy_model",
        "installed_agy_version",
        "matrix_sha256",
        "matrix_agy_version",
        "matrix_source_revision"
      ],
      "properties": {
        "selection_mode": {"const": "exact-model"},
        "resolved_agy_model": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"}
      },
      "not": {
        "anyOf": [
          {"required": ["selected_tier"]},
          {"required": ["selected_tier_source"]},
          {"required": ["user_effort"]},
          {"required": ["user_effort_source"]}
        ]
      }
    },
    {
      "title": "reviewed model and effort selection",
      "required": [
        "schema_version",
        "kind",
        "selection_mode",
        "user_model",
        "user_model_source",
        "user_effort",
        "user_effort_source",
        "resolved_agy_model",
        "installed_agy_version",
        "matrix_sha256",
        "matrix_agy_version",
        "matrix_source_revision"
      ],
      "properties": {
        "selection_mode": {"const": "model-effort"},
        "resolved_agy_model": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"}
      },
      "not": {
        "anyOf": [
          {"required": ["selected_tier"]},
          {"required": ["selected_tier_source"]}
        ]
      }
    }
  ]
}
