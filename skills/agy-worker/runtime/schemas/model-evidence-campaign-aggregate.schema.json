{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "total_records",
    "by_lane",
    "by_status",
    "by_verification",
    "total_samples",
    "total_invocations"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [1]
    },
    "kind": {
      "type": "string",
      "enum": ["agy-model-evidence-campaign-aggregate"]
    },
    "total_records": {
      "type": "integer",
      "minimum": 0
    },
    "by_lane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vendor_declared", "measured", "observational"],
      "properties": {
        "vendor_declared": {
          "type": "integer",
          "minimum": 0
        },
        "measured": {
          "type": "integer",
          "minimum": 0
        },
        "observational": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "by_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluated",
        "verified_measured",
        "no_recommendation",
        "unreviewed"
      ],
      "properties": {
        "evaluated": {
          "type": "integer",
          "minimum": 0
        },
        "verified_measured": {
          "type": "integer",
          "minimum": 0
        },
        "no_recommendation": {
          "type": "integer",
          "minimum": 0
        },
        "unreviewed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "by_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "failed"],
      "properties": {
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "total_samples": {
      "type": "integer",
      "minimum": 0
    },
    "total_invocations": {
      "type": "integer",
      "minimum": 0
    }
  }
}
