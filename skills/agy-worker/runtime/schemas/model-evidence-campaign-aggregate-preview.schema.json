{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "preview_sha256", "payload"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [1]
    },
    "kind": {
      "type": "string",
      "enum": ["agy-model-evidence-campaign-aggregate-preview"]
    },
    "preview_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "payload": {
      "$ref": "model-evidence-campaign-aggregate.schema.json"
    }
  }
}
